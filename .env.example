# ORENTY (orenty.in) Environment Variables Example
# Duplicate this file to .env.local and populate the secrets.
# Do NOT commit .env.local to Git.

# Supabase Credentials (Optional for local development; system falls back to server-side logging if unset)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Rate Limiting Settings
RATE_LIMIT_MAX_PER_MINUTE=5

# Site Host Configuration
NEXT_PUBLIC_SITE_URL=https://orenty.in
